# UC12 ChainForge Eval — Environment Variables
# Copy to .env and fill in values. Never commit .env.

# External model API keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ChainForge server port (avoid 8000=LangGraph, 5678=n8n, 3000=OpenWebUI)
CHAINFORGE_PORT=8765

# Local Ollama endpoint (change host for remote GPU rig)
OLLAMA_BASE_URL=http://localhost:11434/v1
