# ChainForge — AI prompt evaluation UI
# Installs from PyPI, serves on port 8000 (mapped to 8765 in docker-compose.yml)

FROM python:3.11-slim

WORKDIR /app

# Install ChainForge
RUN pip install --no-cache-dir chainforge

# Expose internal port
EXPOSE 8000

# Start ChainForge bound to all interfaces so Docker port mapping works
# ChainForge serve reads ANTHROPIC_API_KEY / OPENAI_API_KEY from env automatically
CMD ["chainforge", "serve", "--host", "0.0.0.0", "--port", "8000"]
