        "data": {
          "title": "Resource Guard Judge (1-5)",
          "grader": {
            "key": "judge-llama3-1",
            "name": "llama3.1 (judge)",
            "emoji": "J",
            "model": "llama3.1:8b",
            "base_model": "openai",
            "temp": 0.1,
            "settings": {
              "system_msg": "",
              "temperature": 0.1,
              "base_url": "http://localhost:11434/v1",
              "api_key": "ollama",
              "response_format": {
                "type": "text"
              },
