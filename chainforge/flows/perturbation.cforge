{
  "flow": {
    "nodes": [
      {
        "id": "cmt-0edd42a93922",
        "type": "comment",
        "position": {
          "x": -900,
          "y": -200
        },
        "data": {
          "title": "Semantic Perturbation Invariance",
          "text": "Each row has two isomorphic problem variants (same structure, different surface entities).\nModels should score equally on both. Large score differences reveal memorization vs reasoning.\nDelta = |score_A - score_B|. Lower delta = better generalization.",
          "color": "#fff0d0"
        }
      },
      {
        "id": "tbl-bd805ddcd29a",
        "type": "table",
        "position": {
          "x": -900,
          "y": 100
        },
        "data": {
          "title": "Paired Problem Variants",
          "columns": [
            {
              "header": "problem",
              "width": 120,
              "accessor": "c0"
            },
            {
              "header": "variant_a",
              "width": 260,
              "accessor": "c1"
            },
            {
              "header": "variant_b",
              "width": 260,
              "accessor": "c2"
            },
            {
              "header": "expected_a",
              "width": 160,
              "accessor": "c3"
            },
            {
              "header": "expected_b",
              "width": 160,
              "accessor": "c4"
            }
          ],
          "rows": [
            {
              "problem": "sheep_farmer",
              "variant_a": "A farmer has 17 sheep. All but 9 die. How many sheep are left?",
              "variant_b": "A rancher has 43 llamas. All but 17 survive. How many llamas are left?",
              "expected_a": "9",
              "expected_b": "17"
            },
            {
              "problem": "widget_machines",
              "variant_a": "If 5 machines make 5 widgets in 5 minutes, how long does it take 100 machines to make 100 widgets?",
              "variant_b": "If 8 robots assemble 8 units in 8 seconds, how long does it take 200 robots to assemble 200 units?",
              "expected_a": "5 minutes",
              "expected_b": "8 seconds"
            },
            {
              "problem": "jug_problem",
              "variant_a": "You have a 3-litre and a 5-litre jug. Measure exactly 4 litres.",
              "variant_b": "You have a 4-litre and a 7-litre jug. Measure exactly 5 litres.",
              "expected_a": "fill 5, pour into 3, empty 3, pour remainder, fill 5, top off 3, 4L left",
              "expected_b": "fill 7, pour into 4, empty 4, pour remainder 3 into 4, fill 7, pour into 4 to fill it (needs 1L), 6L left\u2014wait: fill 4, pour into 7, fill 4 again, pour into 7 until full (needs 3L), 1L remains in 4, empty 7, pour 1L into 7, fill 4, pour into 7 = 5L"
            },
            {
              "problem": "logic_syllogism",
              "variant_a": "All cats are mammals. All mammals are animals. Is a cat an animal?",
              "variant_b": "All prime numbers are integers. All integers are rational numbers. Is 7 a rational number?",
              "expected_a": "yes",
              "expected_b": "yes"
            }
          ]
        }
      },
