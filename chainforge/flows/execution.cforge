      {
        "id": "eval-1635c5ee1d91",
        "type": "evaluator",
        "position": {
          "x": 420,
          "y": 100
        },
        "data": {
          "title": "Pass/Fail Test Runner",
          "language": "python",
          "sandbox": true,
          "refresh": false,
          "code": "def evaluate(r):\n    import re, textwrap\n    code = r.text\n    # strip markdown fences\n    code = re.sub(r'```[\\w]*\\n?', '', code).strip()\n    test = r.meta.get('test_code', '')\n    full = textwrap.dedent(code) + '\\n\\n' + textwrap.dedent(test)\n    try:\n        exec(full, {})\n        return True\n    except Exception as e:\n        print(f'FAIL [{r.meta.get(\"task\",\"?\")}]: {type(e).__name__}: {e}')\n        return False\n"
        }
      },
