          "title": "Reasoning & Code Test Cases",
          "columns": [
            {"header": "category", "key": "category"},
            {"header": "problem", "key": "problem"},
            {"header": "expected", "key": "expected"}
          ],
          "rows": [
            {"__uid": "r1", "category": "reasoning", "problem": "A farmer has 17 sheep. All but 9 die. How many sheep are left?", "expected": "9"},
            {"__uid": "r2", "category": "reasoning", "problem": "If it takes 5 machines 5 minutes to make 5 widgets, how long does it take 100 machines to make 100 widgets?", "expected": "5 minutes"},
            {"__uid": "r3", "category": "reasoning", "problem": "You have a 3-litre jug and a 5-litre jug. How do you measure exactly 4 litres?", "expected": "fill 5L pour into 3L empty 3L pour 2L fill 5L top off 4L remains"},
            {"__uid": "c1", "category": "code_gen", "problem": "Write a Python function is_palindrome(s) that returns True if s is a palindrome. Handle None, empty string, and mixed case.", "expected": "handles None empty case-insensitive"},
            {"__uid": "c2", "category": "code_gen", "problem": "Write a Python function flatten(lst) that flattens a nested list of arbitrary depth into a flat list.", "expected": "recursive or iterative handles arbitrary nesting"},
            {"__uid": "c3", "category": "code_gen", "problem": "Write a Python function retry(func, retries=3, delay=1) that retries func on exception with delay between attempts.", "expected": "uses try/except sleep raises on final failure"},
            {"__uid": "i1", "category": "instruction", "problem": "List exactly 5 programming languages. No bullet points. Each language must start with a different letter. Total response under 30 words.", "expected": "5 languages no bullets different first letters under 30 words"},
            {"__uid": "i2", "category": "instruction", "problem": "Summarize what Docker does in exactly 20 words. The word isolation must appear. No technical jargon.", "expected": "exactly 20 words contains isolation plain language"}
          ]
        }
