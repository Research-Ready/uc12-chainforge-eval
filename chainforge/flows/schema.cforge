        "data": {
          "title": "Extraction Test Cases",
          "columns": [
            {"header": "schema_desc", "key": "schema_desc"},
            {"header": "input_text", "key": "input_text"},
            {"header": "required_keys", "key": "required_keys"}
          ],
          "rows": [
            {
              "__uid": "j1",
              "schema_desc": "Extract to JSON with keys: name (string), age (integer), skills (array of strings)",
              "input_text": "Jane is 28 years old and knows Python, SQL, and Tableau.",
              "required_keys": "name,age,skills"
            },
            {
              "__uid": "j2",
              "schema_desc": "Extract to JSON with keys: company (string), founded (integer), products (array)",
              "input_text": "Apple was founded in 1976 and makes the iPhone, iPad, and MacBook.",
              "required_keys": "company,founded,products"
            },
            {
              "__uid": "j3",
              "schema_desc": "Extract to JSON with keys: sentiment (positive/negative/neutral), confidence (0.0-1.0), keywords (array, max 3 items)",
              "input_text": "The product launch exceeded expectations — sales were up 40% and customer reviews are outstanding.",
              "required_keys": "sentiment,confidence,keywords"
            },
            {
              "__uid": "j4",
              "schema_desc": "Extract to JSON with keys: event (string), date (string), location (string), attendees (integer)",
              "input_text": "The annual AI summit will take place on March 15 at the Amsterdam RAI convention centre with an expected 2400 attendees.",
              "required_keys": "event,date,location,attendees"
            },
            {
              "__uid": "j5",
              "schema_desc": "Extract to JSON with keys: repo (string), language (string), stars (integer), open_issues (integer), license (string)",
              "input_text": "The pytorch/pytorch repository is written in Python, has 84000 stars, 14500 open issues, and uses the BSD-3 license.",
              "required_keys": "repo,language,stars,open_issues,license"
            }
          ]
        }
